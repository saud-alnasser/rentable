{
	"private": true,
	"name": "rentable",
	"description": "the rentable workspace",
	"type": "module",
	"scripts": {
		"dev": "pnpm --filter ./apps/desktop dev",
		"build": "turbo run build",
		"preview": "pnpm --filter ./apps/desktop preview",
		"check": "pnpm --filter ./apps/desktop check && prettier --check .",
		"format": "prettier --write .",
		"lint": "prettier --check . --end-of-line auto && eslint .",
		"test": "turbo run test",
		"test:rust": "turbo run test:rust",
		"db:generate": "pnpm --filter ./apps/desktop db:generate",
		"db:migrate": "pnpm --filter ./apps/desktop db:migrate",
		"db:studio": "pnpm --filter ./apps/desktop db:studio",
		"db:seed": "pnpm --filter ./apps/desktop db:seed",
		"db:purge": "pnpm --filter ./apps/desktop db:purge",
		"tauri": "pnpm --filter ./apps/desktop tauri",
		"prototype": "pnpm --filter ./apps/desktop prototype",
		"i18n": "pnpm --filter ./apps/desktop i18n"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^0.7.0",
		"@changesets/cli": "^2.31.1",
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.8.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.56.8",
		"turbo": "^2.10.10",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0"
	},
	"engines": {
		"node": "^24.0.0",
		"pnpm": ">=11.0.0"
	},
	"packageManager": "pnpm@11.18.0"
}
