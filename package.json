{
	"private": true,
	"name": "rentable",
	"description": "the rentable workspace",
	"type": "module",
	"scripts": {
		"dev": "pnpm --parallel --filter \"./apps/*\" dev",
		"dev:desktop": "pnpm --filter ./apps/desktop dev",
		"dev:control-plane": "pnpm --filter ./apps/control-plane dev",
		"dev:web": "pnpm --filter ./apps/desktop dev:web",
		"build": "pnpm --filter \"./apps/*\" build",
		"build:desktop": "pnpm --filter ./apps/desktop build",
		"build:control-plane": "pnpm --filter ./apps/control-plane build",
		"build:web": "turbo run build:web",
		"check": "pnpm -r --if-present check && prettier --check .",
		"format": "prettier --write .",
		"lint": "prettier --check . --end-of-line auto && eslint .",
		"test": "turbo run test",
		"test:rust": "turbo run test:rust",
		"db:generate:desktop": "pnpm --filter ./apps/desktop db:generate",
		"db:generate:control-plane": "pnpm --filter ./apps/control-plane db:generate",
		"db:migrate:desktop": "pnpm --filter ./apps/desktop db:migrate",
		"db:migrate:control-plane": "pnpm --filter ./apps/control-plane db:migrate",
		"db:studio:desktop": "pnpm --filter ./apps/desktop db:studio",
		"db:studio:control-plane": "pnpm --filter ./apps/control-plane db:studio",
		"db:seed:desktop": "pnpm --filter ./apps/desktop db:seed",
		"db:purge:desktop": "pnpm --filter ./apps/desktop db:purge",
		"tauri": "pnpm --filter ./apps/desktop tauri",
		"prototype": "pnpm --filter ./apps/desktop prototype",
		"i18n": "pnpm --filter ./apps/desktop i18n"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.0",
		"@changesets/cli": "^3.0.1",
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"eslint": "^10.9.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.56.10",
		"turbo": "^2.10.11",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0"
	},
	"engines": {
		"node": "^24.0.0",
		"pnpm": ">=11.0.0"
	},
	"packageManager": "pnpm@11.22.0"
}
