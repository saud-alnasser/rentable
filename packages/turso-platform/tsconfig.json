{
	// The package has no build. `exports` points both conditions at the sources, and a
	// consumer compiles them; there is no consumer today, which is the point of the package:
	// the desktop's Platform API client is the Rust one, and this is what the control plane knew
	// about Turso, kept in TypeScript so a hosted tier remains possible without being planned.
	// What this configuration does is check the package on its own terms, tests included.
	"compilerOptions": {
		"target": "es2023",
		"lib": ["es2023", "dom"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"types": ["node"],
		"allowImportingTsExtensions": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true
	},
	"include": ["index.ts", "migration.ts", "failure.ts", "tests/**/*.ts"]
}
