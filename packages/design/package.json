{
	"private": true,
	"name": "@rentable/design",
	"version": "0.0.0",
	"description": "the interface every rentable client is drawn from",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*",
		"#tests/*": "./src/tests/*"
	},
	"exports": {
		"./*": {
			"svelte": "./src/lib/*",
			"types": "./src/lib/*",
			"default": "./src/lib/*"
		}
	},
	"files": [
		"src",
		"svelte.config.js"
	],
	"scripts": {
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"lint": "eslint .",
		"test": "node --import tsx --test \"src/**/!(*.svelte).test.ts\" && vitest run"
	},
	"dependencies": {
		"@internationalized/date": "^3.12.3",
		"@lucide/svelte": "^1.33.0",
		"@tanstack/table-core": "^8.21.3",
		"@trpc/server": "^11.18.0",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"embla-carousel-svelte": "^8.6.0",
		"formsnap": "^2.0.1",
		"layerchart": "2.3.0",
		"mode-watcher": "^1.1.0",
		"paneforge": "^1.0.2",
		"svelte-sonner": "^1.2.1",
		"sveltekit-superforms": "^2.30.2",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"vaul-svelte": "1.0.0-next.7"
	},
	"devDependencies": {
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@testing-library/svelte": "^5.4.2",
		"jsdom": "^30.0.1",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.12",
		"typescript": "^7.0.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	}
}
