{
	"private": true,
	"name": "@rentable/design",
	"version": "0.0.0",
	"description": "the interface every rentable client is drawn from",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"exports": {
		"./*": {
			"svelte": "./src/lib/*",
			"types": "./src/lib/*",
			"default": "./src/lib/*"
		}
	},
	"files": [
		"src",
		"svelte.config.js"
	],
	"scripts": {
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"lint": "eslint .",
		"test": "vitest run"
	},
	"dependencies": {
		"@lucide/svelte": "^1.33.0",
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.6.0"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@testing-library/svelte": "^5.4.2",
		"jsdom": "^30.0.1",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	}
}
