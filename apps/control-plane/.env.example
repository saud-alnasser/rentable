# Where the control plane's own database is. A local file is the default and needs nothing
# else; a hosted one is a libsql:// URL and needs the token below.
CONTROL_PLANE_DATABASE_URL=file:./control-plane.db

# Only for a hosted database. Leave it unset against a local file.
CONTROL_PLANE_DATABASE_TOKEN=

# What the server listens on. 4000 if unset.
PORT=4000

# How the control plane provisions a workspace's database. All three are required and the
# process refuses to start without them, because a control plane that cannot provision looks
# healthy right up until somebody creates a workspace.
#
# The token is a *Platform API* token, not a database token: `turso auth api-tokens create`,
# or the dashboard. The group has to exist already.
TURSO_API_TOKEN=
TURSO_ORG=
TURSO_GROUP=
