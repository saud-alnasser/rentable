{
	// The checking configuration. It covers the tests as well as the source — a test excluded
	// from the typecheck is a test that can drift away from the module it pins without anything
	// saying so. Both are TypeScript since #559, so there is no `allowJs` here any more: the
	// tests were `.mjs` under `checkJs` and carried their types as JSDoc casts.
	"compilerOptions": {
		"target": "es2023",
		"lib": ["es2023"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"types": ["node"],
		"allowImportingTsExtensions": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true
	},
	"include": ["src/**/*.ts", "drizzle.config.ts"]
}
