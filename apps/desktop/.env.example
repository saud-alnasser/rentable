# Where the drizzle tooling reads and writes the local workspace database. The application does
# not use it: the Rust side owns the path its replica lives at, so this value is only for
# `db:generate:desktop`, `db:studio:desktop`, and the seed and purge scripts.
DATABASE_URL="file:./tauri/app.db"

# The public key the Tauri updater verifies signed releases against. Generate it from your
# updater signing setup and paste the public half here.
TAURI_UPDATER_PUBLIC_KEY="PASTE_YOUR_TAURI_UPDATER_PUBLIC_KEY_HERE"

# Nothing else is needed to run the application. It signs a person in with a password that
# opens their place in an organization on their own Turso account, granted once through a
# consent in the browser; there is no service of ours to point it at and no OAuth client to
# register. *A control plane URL and a Google OAuth client stood here until organizations
# arrived; both retired with them.*

# Optional, and only for the Rust tests that reach a live Turso account. Every one of them is
# ignored by default and armed by RENTABLE_LIVE_TURSO=1 as well as by --ignored. The consent
# token is the one the application files in the credential store after a consent, read out for
# the run; TURSO_ORG is the organization slug and TURSO_GROUP the group the consent was over.
# RENTABLE_LIVE_TURSO=1
# TURSO_CONSENT_TOKEN=""
# TURSO_ORG=""
# TURSO_GROUP=""

# The older two-writer conflict test under `tauri/src/database/test/` reads a Platform API
# token under this name instead, and skips itself where it is unset.
# TURSO_API_TOKEN=""

# CI and release only. Set these in GitHub Actions secrets, never in a local .env file.
# TAURI_SIGNING_PRIVATE_KEY=""
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=""
