# Where the drizzle tooling reads and writes the local workspace database. The application does
# not use it: the Rust side owns the path its replica lives at, so this value is only for
# `db:generate:desktop`, `db:studio:desktop`, and the seed and purge scripts.
DATABASE_URL="file:./tauri/app.db"

# Where the control plane is. Without it the application does nothing.
#
# rentable is a sign-in wall before it is anything else, and signing in is what mints the token
# the workspace replicates with, so a build told no URL reaches no account and opens no
# workspace. The Rust side reads this from the process environment, which is why `pnpm dev`
# loads this file before it spawns the Tauri CLI.
#
# Locally it is whatever apps/control-plane listens on, whose own .env sets PORT. On a second
# machine it is the first machine's address rather than localhost.
RENTABLE_CONTROL_PLANE_URL="http://localhost:4000"

# Signing in. Create an OAuth desktop client in Google Cloud and paste its credentials here.
# These are identity rather than file sync: Google Drive sync was retired and sign-in is what
# survived it, so without them there is no way into the application at all.
GOOGLE_OAUTH_CLIENT_ID="PASTE_YOUR_GOOGLE_OAUTH_CLIENT_ID_HERE"
GOOGLE_OAUTH_CLIENT_SECRET="PASTE_YOUR_GOOGLE_OAUTH_CLIENT_SECRET_HERE"

# The public key the Tauri updater verifies signed releases against. Generate it from your
# updater signing setup and paste the public half here.
TAURI_UPDATER_PUBLIC_KEY="PASTE_YOUR_TAURI_UPDATER_PUBLIC_KEY_HERE"

# Optional, and only for the Rust tests that reach a live Turso account. The two-writer conflict
# test is ignored by default and skips itself when these are unset. TURSO_GROUP is the same
# value the control plane uses.
# TURSO_API_TOKEN=""
# TURSO_ORG=""
# TURSO_GROUP=""

# CI and release only. Set these in GitHub Actions secrets, never in a local .env file.
# TAURI_SIGNING_PRIVATE_KEY=""
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=""
