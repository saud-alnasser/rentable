{
	"private": true,
	"name": "@rentable/desktop",
	"version": "0.13.0",
	"description": "a rents payment tracker",
	"type": "module",
	"scripts": {
		"dev": "node ./scripts/tauri-with-env.mjs dev",
		"dev:web": "vite dev",
		"build": "node ./scripts/tauri-with-env.mjs build",
		"build:web": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "eslint .",
		"test": "node --import tsx --test --experimental-test-module-mocks \"src/**/!(*.svelte).test.ts\" && vitest run",
		"test:rust": "cargo test --manifest-path ./tauri/Cargo.toml -- --test-threads=1",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:seed": "tsx ./scripts/seed.ts",
		"db:purge": "tsx ./scripts/purge.ts",
		"tauri": "node ./scripts/tauri-with-env.mjs",
		"prototype": "node ./scripts/prototype.mjs",
		"i18n": "typesafe-i18n"
	},
	"dependencies": {
		"@rentable/design": "workspace:*",
		"@rentable/workspace-migrations": "workspace:*",
		"@rentable/workspace-permission": "workspace:*",
		"@tabler/icons-svelte": "^3.46.0",
		"@tanstack/svelte-query": "^6.1.38",
		"@tanstack/svelte-virtual": "^3.13.36",
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/plugin-dialog": "^2.7.2",
		"@tauri-apps/plugin-opener": "^2.5.4",
		"@tauri-apps/plugin-updater": "^2.10.1",
		"@trpc/server": "^11.18.0",
		"@tursodatabase/sync": "0.7.2",
		"drizzle-orm": "^0.45.2",
		"typesafe-i18n": "^5.27.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@faker-js/faker": "^10.6.0",
		"@internationalized/date": "^3.12.3",
		"@lucide/svelte": "^1.33.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/cli": "^2.11.4",
		"@testing-library/svelte": "^5.4.2",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^24.13.3",
		"better-sqlite3": "^13.0.3",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.9.0",
		"jsdom": "^30.0.1",
		"randexp": "^0.5.3",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"sveltekit-superforms": "^2.30.2",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.12",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	}
}
