{
	"private": true,
	"name": "@rentable/desktop",
	"version": "0.13.0",
	"description": "a rents payment tracker",
	"type": "module",
	"scripts": {
		"dev": "node ./scripts/tauri-with-env.mjs dev",
		"dev:web": "vite dev",
		"build": "node ./scripts/tauri-with-env.mjs build",
		"build:web": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "eslint .",
		"test": "node --import tsx --test --experimental-test-module-mocks \"src/**/*.test.ts\"",
		"test:rust": "cargo test --manifest-path ./tauri/Cargo.toml -- --test-threads=1",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:seed": "tsx ./scripts/seed.ts",
		"db:purge": "tsx ./scripts/purge.ts",
		"tauri": "node ./scripts/tauri-with-env.mjs",
		"prototype": "node ./scripts/prototype.mjs",
		"i18n": "typesafe-i18n"
	},
	"dependencies": {
		"@tabler/icons-svelte": "^3.46.0",
		"@tanstack/svelte-query": "^6.1.38",
		"@tanstack/svelte-virtual": "^3.13.35",
