{
	"$schema": "https://turborepo.dev/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["build/**"]
		},
		"test": {
			"outputs": []
		},
		"test:rust": {
			"inputs": ["tauri/**", "!tauri/target/**", "!tauri/gen/**", "!tauri/app.db*", "package.json"],
			"outputs": [],
			"env": ["TAURI_UPDATER_PUBLIC_KEY"]
		}
	}
}
